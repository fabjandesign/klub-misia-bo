<script is:inline>
var Webflow = Webflow || [];
Webflow.push(function () {


  $('form[action^="https://hook.eu1.make.com/"]').off('submit').on('submit', function (e) {
    e.preventDefault();

    const $form = $(this);
    const $submit = $('[type=submit]', $form);
    const buttonText = $submit.val();
    const buttonWaitingText = $submit.attr('data-wait');
    const formMethod = $form.attr('method');
    const formAction = $form.attr('action');
    const formRedirect = $form.attr('data-redirect');

    if (buttonWaitingText) {
      $submit.val(buttonWaitingText);
    }

    // Sprawdzenie, czy token Turnstile został ustawiony
    if (typeof turnstileToken === 'undefined' || !turnstileToken) {
      $submit.val(buttonText);
      alert('Proszę przejść weryfikację!');
      return;
    }

    // Dodanie tokena tylko jeśli go nie ma
    if (!$form.find('[name="cf-turnstile-response"]').length) {
      $form.append('<input type="hidden" name="cf-turnstile-response" value="' + turnstileToken + '">');
    }

    $submit.prop('disabled', true);
    const formData = $form.serialize();

    $.ajax(formAction, {
        data: formData,
        method: formMethod
      })
      .done((res) => {
        if (formRedirect) { window.location = formRedirect; return; }
        $form.hide().siblings('.w-form-done').show().siblings('.w-form-fail').hide();
      })
      .fail((res) => {
        $form.siblings('.w-form-done').hide().siblings('.w-form-fail').show();
      })
      .always(() => {
        $submit.val(buttonText).prop('disabled', false);
      });
  });
});
</script>
