---
import { formatNumber } from '@/lib/format';
import ButtonArrow from '@/components/button/ButtonArrow.astro';

interface Props {
  /** Classes */
  classes?: string;
  /** Settings/Speed */
  settingsSpeed?: number;
  /** Settings/Slide To Clicked Slide */
  settingsSlideToClickedSlide?: string;
  /** Settings/Mousewheel */
  settingsMousewheel?: string;
  /** Settings/Free Mode */
  settingsFreeMode?: string;
  /** Settings/Follow Finger */
  settingsFollowFinger?: string;
  /** Settings/Controls Visibility */
  settingsControlsVisibility?: boolean;
  /** Slides Per View */
  slidesPerView?: string;
  /** Variant */
  variant?: "overflow-visible" | "overflow-hidden" | "crop-left";
  /** Visibility */
  visibility?: boolean;
}
const collectionData = {};
const {
  classes: propClasses = " ",
  settingsSpeed: propSettingsSpeed = 600,
  settingsSlideToClickedSlide: propSettingsSlideToClickedSlide = "false",
  settingsMousewheel: propSettingsMousewheel = "true",
  settingsFreeMode: propSettingsFreeMode = "false",
  settingsFollowFinger: propSettingsFollowFinger = "true",
  settingsControlsVisibility: propSettingsControlsVisibility = true,
  slidesPerView: propSlidesPerView = "--lg: 4; --md: 3; --sm: 2; --xs: 1;",
  variant: propVariant = "overflow-visible",
  visibility: propVisibility = true
} = Astro.props;
if (!["overflow-visible", "overflow-hidden", "crop-left"].includes(propVariant)) throw new Error("Slider.variant must be one of: overflow-visible, overflow-hidden, crop-left");


---
{propVisibility && (<div class:list={[{"overflow-hidden": "w-variant-bfb8c45c-dbfa-13cc-2dfc-0c02a34504e4", "crop-left": "w-variant-b8ee48da-439e-7156-5d2e-5b4f080e200e"}[propVariant], "slider_wrap", propClasses]} data-slider="component" data-wf-id="baf5fd6d-12da-786a-f303-1676d3e63f09" data-w-id="baf5fd6d-12da-786a-f303-1676d3e63f09" data-wf--slider--variant={{"overflow-visible": "overflow-visible", "overflow-hidden": "overflow-hidden", "crop-left": "crop-left"}[propVariant]} data-wf-variant={["9af63a7f-5438-6cac-b11b-9a5465fdccfd=" + ({"overflow-visible": "base", "overflow-hidden": "bfb8c45c-dbfa-13cc-2dfc-0c02a34504e4", "crop-left": "b8ee48da-439e-7156-5d2e-5b4f080e200e"}[propVariant])].join(" ")}>
<div data-wf-id="baf5fd6d-12da-786a-f303-1676d3e63f0a" data-w-id="baf5fd6d-12da-786a-f303-1676d3e63f0a" class="w-embed u-embed-css">
<style is:inline>
html .slider_list > :not(.u-display-contents, .w-dyn-list),
.slider_list > .w-dyn-list > * > * > *,
.slider_list > .u-display-contents > *,
.slider_list > .u-display-contents > .u-display-contents > *,
.slider_list > .u-display-contents > .w-dyn-list > * > * > *,
.slider_list > .u-display-contents > .u-display-contents > .w-dyn-list > * > * > * {
	padding-inline: calc(var(--_gap---size) / 2);
	height: auto !important;
	flex: 0 0 auto;
	width: calc(100% / var(--slide-count));
}
</style>
</div>
<div style={propSlidesPerView} data-wf-id="baf5fd6d-12da-786a-f303-1676d3e63f0b" data-w-id="baf5fd6d-12da-786a-f303-1676d3e63f0b" class="slider_offset">
<div data-follow-finger={propSettingsFollowFinger} data-free-mode={propSettingsFreeMode} data-mousewheel={propSettingsMousewheel} data-slide-to-clicked={propSettingsSlideToClickedSlide} data-speed={formatNumber(propSettingsSpeed, -1)} data-wf-id="baf5fd6d-12da-786a-f303-1676d3e63f0c" data-w-id="baf5fd6d-12da-786a-f303-1676d3e63f0c" class="slider_element swiper">
<div data-slot="" data-wf-id="cca5f7d9-ee36-37b8-618c-bcea647f5fb7" data-w-id="cca5f7d9-ee36-37b8-618c-bcea647f5fb7" class="slider_list swiper-wrapper" name="">
<slot />
</div>
</div>
</div>
{propSettingsControlsVisibility && (<div data-wf-id="baf5fd6d-12da-786a-f303-1676d3e63f15" data-w-id="baf5fd6d-12da-786a-f303-1676d3e63f15" class="slider_controls">
{false && (<div data-wf-id="baf5fd6d-12da-786a-f303-1676d3e63f16" data-w-id="baf5fd6d-12da-786a-f303-1676d3e63f16" class="slider_bullet_list">
<div data-wf-id="baf5fd6d-12da-786a-f303-1676d3e63f17" data-w-id="baf5fd6d-12da-786a-f303-1676d3e63f17" class="slider_bullet_item is-active"></div>
<div data-wf-id="baf5fd6d-12da-786a-f303-1676d3e63f18" data-w-id="baf5fd6d-12da-786a-f303-1676d3e63f18" class="slider_bullet_item"></div>
</div>)}
<div data-wf-id="baf5fd6d-12da-786a-f303-1676d3e63f19" data-w-id="baf5fd6d-12da-786a-f303-1676d3e63f19" class="slider_button_layout">
<ButtonArrow attributeValue="previous" attributeName="data-slider" arrowDirection="left" variant="secondary-medium">
Previous
</ButtonArrow>
<ButtonArrow attributeValue="next" attributeName="data-slider" variant="secondary-medium" />
</div>
</div>)}
<div data-wf-id="baf5fd6d-12da-786a-f303-1676d3e63f1e" data-w-id="baf5fd6d-12da-786a-f303-1676d3e63f1e" class="w-embed u-embed-js">
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@8/swiper-bundle.min.css">
<script src="https://cdn.jsdelivr.net/npm/swiper@8/swiper-bundle.min.js" is:inline></script>
<script is:inline>
(function onReady(callback, options) {
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", callback, options);
  } else if (!options?.signal?.aborted) {
    const event = new Event("DOMContentLoaded");
    if (typeof callback === "function") callback.call(document, event);
    else callback?.handleEvent(event);
  }
})( () => {
  document.querySelectorAll("[data-slider='component']:not([data-slider='component'] [data-slider='component'])").forEach((component) => {
    if (component.dataset.scriptInitialized) return;
    component.dataset.scriptInitialized = "true";

    const swiperElement = component.querySelector(".slider_element");
    const swiperWrapper = component.querySelector(".slider_list");
    if (!swiperElement || !swiperWrapper) return;

    function flattenDisplayContents(slot) {
      if (!slot) return;
      let child = slot.firstElementChild;
      while (child && child.classList.contains("u-display-contents")) {
        while (child.firstChild) {
          slot.insertBefore(child.firstChild, child);
        }
        slot.removeChild(child);
        child = slot.firstElementChild;
      }
    }
		flattenDisplayContents(swiperWrapper);
    
    function removeCMSList(slot) {
      const dynList = Array.from(slot.children).find((child) => child.classList.contains("w-dyn-list"));
      if (!dynList) return;
      const nestedItems = dynList?.querySelector(".w-dyn-items")?.children;
      if (!nestedItems) return;
      const staticWrapper = [...slot.children];
			[...nestedItems].forEach(el => { const c = [...el.children].find(c => !c.classList.contains('w-condition-invisible')); c && slot.appendChild(c); });
      staticWrapper.forEach((el) => el.remove());
    }
    removeCMSList(swiperWrapper);

    [...swiperWrapper.children].forEach((el) => el.classList.add("swiper-slide"));

    const followFinger = swiperElement.getAttribute("data-follow-finger") === "true",
      freeMode = swiperElement.getAttribute("data-free-mode") === "true",
      mousewheel = swiperElement.getAttribute("data-mousewheel") === "true",
      slideToClickedSlide = swiperElement.getAttribute("data-slide-to-clicked") === "true",
      speed = +swiperElement.getAttribute("data-speed") || 600;

    new Swiper(swiperElement, {
      slidesPerView: "auto",
      followFinger: followFinger,
      loopAdditionalSlides: 10,
      freeMode: freeMode,
      slideToClickedSlide: slideToClickedSlide,
      centeredSlides: false,
      autoHeight: false,
      speed: speed,
      mousewheel: {
        enabled: mousewheel,
        forceToAxis: true,
      },
      keyboard: {
        enabled: true,
        onlyInViewport: true,
      },
      navigation: {
        nextEl: component.querySelector("[data-slider='next'] button"),
        prevEl: component.querySelector("[data-slider='previous'] button"),
      },
      pagination: {
        el: component.querySelector(".slider_bullet_list"),
        bulletActiveClass: "is-active",
        bulletClass: "slider_bullet_item",
        bulletElement: "button",
        clickable: true,
      },
      slideActiveClass: "is-active",
      slideDuplicateActiveClass: "is-active",
    });
  });
});
</script>
</div>
</div>)}
