  openByDefaultItem?: string;
  /** Open On Hover */
  openOnHover?: string;
  /** Close On Second Click */
  closeOnSecondClick?: string;
  /** Close Previous */
  closePrevious?: string;
  /** Style */
  style?: string;
  /** Classes */
  classes?: string;
  /** Visibility */
  visibility?: boolean;
}
const collectionData = {};
const defaults = {"8048f190-71fa-2367-d7be-c9acdfcc6572": [], "e79125f9-cd38-453c-38bd-817ca040bd18": "", "4868b674-2f4a-22c1-d988-43d096b8fe78": "", "7da0af26-0a7a-89b2-8a9e-bb5c9779f848": "true", "094292d2-7de5-d270-919f-7a20fd3fc3e8": "true", "540ddd7c-6e87-cc95-6fdd-7f748ec26a64": "false", "6a4c6085-b3a2-4b71-bd21-a5dd602d2567": "0", "6aafb57b-8892-cc29-bfa2-610faf201329": []};
const {
  openByDefaultItem: propOpenByDefaultItem = "0",
  openOnHover: propOpenOnHover = "false",
