---
import __lumosAsset50 from '@/assets/694c73b2c4b626475b7c67cb_Tygryski.png?url';
import { imageUrl, imageAlt } from '@/lib/urls';
import TypographyHeading from '@/components/typography/TypographyHeading.astro';

interface Props {
  typographyHeadingTextTag?: string;
  /** Image */
  image?: string | { url?: string; alt?: string; id?: string };
}
const collectionData = {};
const {
  typographyHeadingTextTag: propTypographyHeadingTextTag = "h2",
  image: propImage = {"id": "694c73b2c4b626475b7c67cb"}
} = Astro.props;
const propWiek = "3 latki";
const propTypographyHeadingText = "Lorem ipsum dolor sit amet elit";
const propTitle = "Tygryski Ryki-Tiki";


---
<div data-wf-id="a0757839-5a6e-3ebd-6309-2f09842d375e" data-w-id="a0757839-5a6e-3ebd-6309-2f09842d375e" class="group_card">
<div data-wf-id="a0757839-5a6e-3ebd-6309-2f09842d375f" data-w-id="a0757839-5a6e-3ebd-6309-2f09842d375f" class="img_wrapper">
<img src={imageUrl(propImage) || (__lumosAsset50)} loading="lazy" alt={(imageAlt(propImage)) || ''} data-wf-id="a0757839-5a6e-3ebd-6309-2f09842d3760" data-w-id="a0757839-5a6e-3ebd-6309-2f09842d3760" class="group_img" />
</div>
