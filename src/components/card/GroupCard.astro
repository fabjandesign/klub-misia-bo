</TypographyHeading>
{false && (<h3 data-wf-id="a0757839-5a6e-3ebd-6309-2f09842d3761" data-w-id="a0757839-5a6e-3ebd-6309-2f09842d3761" class="fafa u-text-style-h3 u-alignment-center">
<slot name="title">{propTitle}</slot>
</h3>)}
<div data-wf-id="edf68b01-e953-7bd6-a2d2-6c1207845d14" data-w-id="edf68b01-e953-7bd6-a2d2-6c1207845d14" class="div-block-54">
<div data-wf-id="630073fa-3964-084f-50a8-9808d6f4ff18" data-w-id="630073fa-3964-084f-50a8-9808d6f4ff18" class="adfdas u-text-style-large">
<slot name="wiek">{propWiek}</slot>
</div>
</div>
</div>
